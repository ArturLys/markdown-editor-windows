<Window x:Class="MarkdownView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Markdown"
        WindowState="Maximized"
        WindowStyle="None"
        Background="#1e1e2e">
  <Grid>
    <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#1e1e2e" />

    <Popup x:Name="ClosePopup" Placement="Absolute" AllowsTransparency="True" StaysOpen="True" IsOpen="True">
      <Button x:Name="CloseButton" Width="40" Height="32" Cursor="Hand" ToolTip="Close"
              Foreground="#6c7086" Background="Transparent" BorderThickness="0"
              FontFamily="Segoe UI" FontSize="16" Content="✕">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#40e84393" />
                <Setter Property="Foreground" Value="#e84393" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </Popup>
  </Grid>
</Window>
